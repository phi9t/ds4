# Reviewed rootfs contract for the DS4 CUDA build: pinned base image digest and
# tool versions. Shell data only; source this file, never execute it. Any change
# here defines a new rootfs identity.
#
# The base is the NVIDIA CUDA 13.2 *devel* image (ships nvcc + cuBLAS headers and
# libraries) so the pinned in-rootfs toolkit compiles DS4 while the host driver
# (libcuda.so.580) runs the kernels on the 8x B200 (sm_100) host. The digest is
# the linux/amd64 manifest resolved from the multi-platform image index.
DS4_ROOTFS_SCHEMA=3
DS4_ROOTFS_ARCH=x86_64
DS4_BASE_IMAGE=nvidia/cuda:13.2.0-devel-ubuntu24.04@sha256:d266e59b88c295bc5fa0e4cef9064eaff84939381b09e2c3d76a5532a303e42d
DS4_BAZEL_VERSION=9.2.0
DS4_CUDA_VERSION=13.2

# CUDA channel is the single source of truth tying the host driver floor, the
# rules_cuda redist toolkit, and the compiled arch together. cu132 = CUDA 13.2.
DS4_CUDA_CHANNEL=cu132
# Minimum host libcuda.so.1 version that satisfies cu132 (CUDA 13.2 forward-compat
# floor). nvidia-smi on this host reports driver 580.x / libcuda.so.580.
DS4_DRIVER_FLOOR=580.0
# Tooling baked read-only into /opt/ds4.
DS4_BAZELISK_VERSION=1.26.0
DS4_MISE_VERSION=2025.1.0
# Packages whose presence is part of the execution contract. bubblewrap is
# required by the Colab restored-rootfs launcher, which invokes /usr/bin/bwrap
# from inside the exported rootfs.
DS4_ROOTFS_APT_PACKAGES="bash build-essential gcc g++ make git curl ca-certificates python3 bubblewrap"
